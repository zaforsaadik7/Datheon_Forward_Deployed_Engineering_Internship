# Datheon Task 4 — Client VPC Microservice Environment Template
# Copy to .env or inject via Kubernetes / Docker Compose secrets in production.

FDE_ENV=production
FDE_AIRGAPPED_MODE=true
FDE_PLANNER=rule
FDE_AUTO_SEED=true
FDE_ALLOW_SAMPLE_SEED=false
FDE_MAX_BODY_BYTES=1048576
FDE_RATE_LIMIT_RPS=500.0
FDE_RATE_LIMIT_BURST=1000

# File-mounted secrets inside container (preferred in VPC)
FDE_API_KEYS_JSON_FILE=/run/secrets/fde_api_keys_json
FDE_METRICS_TOKEN_FILE=/run/secrets/fde_metrics_token

# Optional LLM provider configuration (used only when FDE_AIRGAPPED_MODE=false and FDE_PLANNER=openai)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

